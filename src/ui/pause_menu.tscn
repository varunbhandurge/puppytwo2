text = "[b]TACTICAL MAP OVERVIEW (CHAPTER 1)[/b]

▲ [color=#55aaff]NORTH[/color] ──────────────────────────────────────────────
│ [color=#ffd166][EXIT][/color] [b]Back Privacy Gate[/b] (Escape to Forgotten Garden)
│ 
│ [color=#ff6b6b][BOSS ARENA][/color] [b]Mechanical Sprinkler[/b] (Co-op Shutoff)
│ 
│ [color=#06d6a0][MINI-GAME][/color] [b]Squeaky Ball Fetch Basket[/b]
│ 
│ [b]Picnic Table & Bench[/b] (Snout-boost puzzle)
│ 
│ [b]Garden Hose Labyrinth[/b] (Low-crawl tunnel)
│ 
│ [b]The Sandbox Trench[/b] (Dig mound ramp)
│ 
│ [color=#ffd166][SPAWN][/color] [b]The Doghouse Enclave & Stepping Stones[/b]
│ 
▼ [b]South Brick House Wall & Patio Deck[/b]
────────────────────────────────────────────────────"

[node name="BriefingPanel" type="PanelContainer" parent="Margin/Panel/VBox/TabContainer/ObjectivesMap/VBox/HBox"]
layout_mode = 2
