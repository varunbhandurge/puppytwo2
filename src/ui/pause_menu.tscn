[node name="Margin" type="MarginContainer" parent="Margin/Panel/VBox/TabContainer/ObjectivesMap/VBox/HBox/BriefingPanel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="BriefingText" type="RichTextLabel" parent="Margin/Panel/VBox/TabContainer/ObjectivesMap/VBox/HBox/BriefingPanel/Margin"]
layout_mode = 2
bbcode_enabled = true
text = "[b]COOPERATIVE ROLES & CONTROLS[/b]

[color=#ffd166]🐕 BRUNO (Golden Retriever / Heavy Prowler):[/color]
• [b]Move:[/b] W, A, S, D / Left Stick
• [b]Jump:[/b] Space / Button A
• [b]Mighty Dig:[/b] E / Button X (Dig dirt trenches and sand ramps)
• [b]Vocal Bark:[/b] F / Button B (Distract enemies, deflect projectiles)
• [b]Snout-Boost:[/b] E (Launch Milo to higher platforms)

[color=#06d6a0]🐕‍🦺 MILO (Corgi / Scout & Mechanic):[/color]
• [b]Move:[/b] Arrow Keys / Left Stick
• [b]Jump:[/b] R-Ctrl / Button A
• [b]Scent-o-Vision:[/b] V / Button Y (Reveal hidden paths and trails)
• [b]Low-Crawl:[/b] C / Button X (Squeeze under fences and burrows)
• [b]Interact / Lever:[/b] E / Button B (Activate small switches)"

