; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but since it is all text, you can be creative here!

config_version=5

[application]

config/name="Two Puppies: The Great Adventure"
config/description="Premium 3D cooperative adventure game following two puppy protagonists."
config/version="1.0.0"
run/main_scene="res://src/chapters/chapter_1_backyard/chapter_1_backyard.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/core/event_bus.gd"
GameManager="*res://src/core/game_manager.gd"
SaveManager="*res://src/core/save_manager.gd"
AudioManager="*res://src/core/audio_manager.gd"
InputManager="*res://src/core/input_manager.gd"
PerformanceOptimizer="*res://src/core/performance_optimizer.gd"
SteamManager="*res://src/platform/steam_manager.gd"
NetworkManager="*res://src/network/network_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=false
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1

[physics]

3d/default_gravity=18.0
3d/physics_engine="GodotPhysics3D"

